# Optional personal credentials used by repository developer and operator tasks.
#
# This is the template. `./make setup local` copies it to .local/env, which the
# task runner loads into the environment of every command; fill in only the
# credentials you use. The whole of .local/ is gitignored and mode 0600.
#
#   ./make setup local

# GitHub API access used by local tooling that talks to GitHub.
GITHUB_TOKEN=

# OpenRouter credential used by ./make ocean model init.
OPENROUTER_API_KEY=

# DigitalOcean external-infrastructure qualification.
DIGITALOCEAN_TOKEN=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

# Application edge for ./make ocean deploy. Use CIDR notation; multiple
# entries may be separated by commas.
BUILDMAX_OCEAN_HOSTNAME=
BUILDMAX_OCEAN_ALLOWED_CIDRS=

# Optional OpenRouter model overrides. These defaults select the repository's
# low-cost managed-model baseline and include its current catalog metadata.
# BUILDMAX_OCEAN_MODEL_NAME=GPT-5.6 Luna
# BUILDMAX_OCEAN_MODEL_PROVIDER=openai
# BUILDMAX_OCEAN_MODEL_API_URL=https://openrouter.ai/api/v1
# BUILDMAX_OCEAN_MODEL_ID=openai/gpt-5.6-luna
# BUILDMAX_OCEAN_MODEL_CONTEXT_WINDOW=1050000
# BUILDMAX_OCEAN_MODEL_CURRENCY=USD
# BUILDMAX_OCEAN_MODEL_INPUT_PRICE=0.2
# BUILDMAX_OCEAN_MODEL_CACHE_READ_PRICE=0.02
# BUILDMAX_OCEAN_MODEL_CACHE_WRITE_PRICE=0.25
# BUILDMAX_OCEAN_MODEL_OUTPUT_PRICE=1.2

# Local port used by ./make ocean database forward.
# BUILDMAX_OCEAN_DATABASE_LOCAL_PORT=13306

# Optional immutable image overrides. Defaults are pinned release digests.
# BUILDMAX_OCEAN_IMAGE=ghcr.io/icloudbb/buildmax@sha256:...
# BUILDMAX_OCEAN_PORTAL_IMAGE=ghcr.io/icloudbb/buildmax-portal@sha256:...
# BUILDMAX_OCEAN_EDGE_IMAGE=caddy:2-alpine@sha256:...
# BUILDMAX_OCEAN_REDIS_IMAGE=redis:7-alpine@sha256:...
