apiVersion: v1
kind: ServiceAccount
metadata:
  name: buildmax-server
  namespace: buildmax
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: buildmax-server
  namespace: buildmax
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["create", "get", "list", "delete"]
  - apiGroups: ["batch"]
    resources: ["jobs"]
    verbs: ["create", "get", "list", "delete"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: buildmax-server
  namespace: buildmax
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: buildmax-server
subjects:
  - kind: ServiceAccount
    name: buildmax-server
    namespace: buildmax
---
# Puts the worker's custom seccomp profile on every node's kubelet seccomp
# directory, from the buildmax-worker-seccomp ConfigMap `ocean deploy` creates
# from deployment/seccomp/worker-bwrap.json. A worker Job names this path as
# its Localhost seccomp profile and cannot start on a node without it. See
# deployment/seccomp/README.md.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: buildmax-worker-seccomp
  namespace: buildmax
spec:
  selector:
    matchLabels:
      app: buildmax-worker-seccomp
  template:
    metadata:
      labels:
        app: buildmax-worker-seccomp
    spec:
      automountServiceAccountToken: false
      tolerations:
        - operator: Exists
      containers:
        - name: install
          image: {{ .BuildMaxImage }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - |
              set -e
              mkdir -p /host-seccomp/buildmax
              cp /profile/worker-bwrap.json /host-seccomp/buildmax/worker-bwrap.json
              echo "installed worker-bwrap.json; watching for updates"
              while true; do sleep 3600; done
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 32Mi
          volumeMounts:
            - name: profile
              mountPath: /profile
            - name: host-seccomp
              mountPath: /host-seccomp
      volumes:
        - name: profile
          configMap:
            name: buildmax-worker-seccomp
        - name: host-seccomp
          hostPath:
            path: /var/lib/kubelet/seccomp
            type: DirectoryOrCreate
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: buildmax-edge-data
  namespace: buildmax
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: buildmax-server
  namespace: buildmax
  labels:
    app: buildmax-server
spec:
  # Two replicas coordinated through buildmax-redis, the Beta profile's shape.
  replicas: 2
  selector:
    matchLabels:
      app: buildmax-server
  strategy:
    rollingUpdate:
      maxUnavailable: 0
  template:
    metadata:
      labels:
        app: buildmax-server
    spec:
      serviceAccountName: buildmax-server
      terminationGracePeriodSeconds: 45
      # Different nodes, so a node drain or loss leaves one replica serving.
      # Counted per revision (pod-template-hash), so a rollout's surge pod is
      # not blocked by the replicas it replaces.
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: DoNotSchedule
          labelSelector:
            matchLabels:
              app: buildmax-server
          matchLabelKeys:
            - pod-template-hash
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: database-trust
          image: {{ .BuildMaxImage }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -ec
            - cp /etc/ssl/certs/ca-certificates.crt /trust/ca-certificates.crt && printf '\n' >> /trust/ca-certificates.crt && cat /database-ca/database-ca.pem >> /trust/ca-certificates.crt
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: database-ca
              mountPath: /database-ca
              readOnly: true
            - name: trust
              mountPath: /trust
      containers:
        - name: server
          image: {{ .BuildMaxImage }}
          imagePullPolicy: IfNotPresent
          command: ["/usr/local/bin/buildmax-server"]
          ports:
            - containerPort: 5678
              name: http
            # The worker control API, reached only through buildmax-worker-api.
            - containerPort: 5679
              name: worker-api
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            periodSeconds: 5
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 15
            periodSeconds: 10
          lifecycle:
            preStop:
              exec:
                command: ["sleep", "5"]
          env:
            - name: BUILDMAX_HOME
              value: /buildmax
            - name: SSL_CERT_FILE
              value: /trust/ca-certificates.crt
            - name: BUILDMAX_JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: buildmax-secret
                  key: BUILDMAX_JWT_SECRET
            - name: BUILDMAX_DATABASE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: buildmax-secret
                  key: BUILDMAX_DATABASE_PASSWORD
            - name: BUILDMAX_STORAGE_MINIO_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: buildmax-secret
                  key: BUILDMAX_STORAGE_MINIO_ACCESS_KEY
            - name: BUILDMAX_STORAGE_MINIO_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: buildmax-secret
                  key: BUILDMAX_STORAGE_MINIO_SECRET_KEY
          volumeMounts:
            - name: buildmax-home
              mountPath: /buildmax
            - name: buildmax-config
              mountPath: /buildmax/server.yaml
              subPath: server.yaml
              readOnly: true
            - name: trust
              mountPath: /trust
              readOnly: true
            # The worker listener's certificate and key; worker pods get only
            # the CA, from buildmax-worker-api-ca.
            - name: worker-api-tls
              mountPath: /buildmax/tls/worker-api
              readOnly: true
            # Deployment key-encryption key, generated once by `ocean deploy`
            # into the state directory. It seals managed-model credentials and
            # Space Secrets; secret.kek_file in server.yaml points here. Kept
            # outside BUILDMAX_HOME (docs/design/space-secrets.md §9.1).
            - name: buildmax-kek
              mountPath: /etc/buildmax/kek
              readOnly: true
            - name: tmp
              mountPath: /tmp
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
            limits:
              cpu: "1"
              memory: 1Gi
      volumes:
        - name: buildmax-home
          emptyDir: {}
        - name: buildmax-config
          configMap:
            name: buildmax-config
        - name: database-ca
          configMap:
            name: buildmax-database-ca
        - name: trust
          emptyDir: {}
        - name: worker-api-tls
          secret:
            secretName: buildmax-worker-api-tls
        # Owner-only 0400; fsGroup makes it 0440 root:65532, readable by the
        # server only.
        - name: buildmax-kek
          secret:
            secretName: buildmax-kek
            defaultMode: 0400
        - name: tmp
          emptyDir: {}
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: buildmax-server
  namespace: buildmax
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: buildmax-server
---
# Live coordination state only -- stream deltas, connection events, and turn
# leases -- so no persistence: a restart costs in-flight deltas and a brief
# lease re-acquire, never durable data.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: buildmax-redis
  namespace: buildmax
  labels:
    app: buildmax-redis
spec:
  replicas: 1
  selector:
    matchLabels:
      app: buildmax-redis
  template:
    metadata:
      labels:
        app: buildmax-redis
    spec:
      automountServiceAccountToken: false
      # The image's redis user. Started as it, the entrypoint skips the setpriv
      # step-down that a root start needs SETUID/SETGID for.
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
      containers:
        - name: redis
          image: {{ .RedisImage }}
          imagePullPolicy: IfNotPresent
          args: ["--save", "", "--appendonly", "no"]
          ports:
            - containerPort: 6379
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          readinessProbe:
            tcpSocket:
              port: 6379
            initialDelaySeconds: 2
            periodSeconds: 5
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
---
apiVersion: v1
kind: Service
metadata:
  name: buildmax-redis
  namespace: buildmax
spec:
  selector:
    app: buildmax-redis
  ports:
    - port: 6379
      targetPort: 6379
---
# Only the Server talks to Redis. Worker pods run model-chosen commands and
# must not reach coordination state.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: buildmax-redis
  namespace: buildmax
spec:
  podSelector:
    matchLabels:
      app: buildmax-redis
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app: buildmax-server
      ports:
        - protocol: TCP
          port: 6379
---
apiVersion: v1
kind: Service
metadata:
  name: buildmax
  namespace: buildmax
spec:
  selector:
    app: buildmax-server
  ports:
    - name: http
      port: 5678
      targetPort: 5678
---
# The internal worker control API. The NetworkPolicy below, not the ClusterIP,
# is what limits who may connect.
apiVersion: v1
kind: Service
metadata:
  name: buildmax-worker-api
  namespace: buildmax
spec:
  type: ClusterIP
  selector:
    app: buildmax-server
  ports:
    - name: worker-api
      port: 5679
      targetPort: 5679
---
# The public port stays open to the cluster for the edge; the worker port
# admits only the pods the Kubernetes runner labels as workers.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: buildmax-server
  namespace: buildmax
spec:
  podSelector:
    matchLabels:
      app: buildmax-server
  policyTypes:
    - Ingress
  ingress:
    - ports:
        - protocol: TCP
          port: 5678
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: buildmax-worker
              app.kubernetes.io/component: worker
      ports:
        - protocol: TCP
          port: 5679
---
# Worker pods run model-chosen commands and need no database: they reach the
# Server through its Services and object storage through the VPC's private
# Spaces endpoint. The managed database admits the whole cluster at its own
# firewall, so this policy is what keeps workers off its private addresses.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: buildmax-worker-egress
  namespace: buildmax
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: buildmax-worker
      app.kubernetes.io/component: worker
  policyTypes:
    - Egress
  egress:
    - to:
        - namespaceSelector: {}
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
            except:
{{- range .DatabaseAddresses }}
              - {{ . }}
{{- end }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: buildmax-portal
  namespace: buildmax
  labels:
    app: buildmax-portal
spec:
  replicas: 1
  selector:
    matchLabels:
      app: buildmax-portal
  template:
    metadata:
      labels:
        app: buildmax-portal
    spec:
      containers:
        - name: portal
          image: {{ .PortalImage }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 80
              name: http
          env:
            - name: BUILDMAX_API_BASE
              value: "/"
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 3
            periodSeconds: 5
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
---
apiVersion: v1
kind: Service
metadata:
  name: buildmax-portal
  namespace: buildmax
spec:
  selector:
    app: buildmax-portal
  ports:
    - name: http
      port: 80
      targetPort: 80
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: buildmax-edge
  namespace: buildmax
  labels:
    app: buildmax-edge
spec:
  replicas: 1
  # The certificate volume is ReadWriteOnce: a rolling update that schedules the
  # new pod on another node waits forever for the old pod's attachment.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: buildmax-edge
  template:
    metadata:
      labels:
        app: buildmax-edge
    spec:
      containers:
        - name: caddy
          image: {{ .EdgeImage }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 80
              name: http
            - containerPort: 443
              name: https
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
              add: ["NET_BIND_SERVICE"]
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 3
            periodSeconds: 5
          volumeMounts:
            - name: caddy-config
              mountPath: /etc/caddy/Caddyfile
              subPath: Caddyfile
              readOnly: true
            - name: caddy-data
              mountPath: /data
            - name: caddy-runtime
              mountPath: /config
            - name: tmp
              mountPath: /tmp
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
      volumes:
        - name: caddy-config
          configMap:
            name: buildmax-edge
        - name: caddy-data
          persistentVolumeClaim:
            claimName: buildmax-edge-data
        - name: caddy-runtime
          emptyDir: {}
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: buildmax-edge
  namespace: buildmax
  annotations:
    service.beta.kubernetes.io/do-loadbalancer-name: buildmax-beta
spec:
  type: LoadBalancer
  externalTrafficPolicy: Local
  selector:
    app: buildmax-edge
  ports:
    - name: http
      port: 80
      targetPort: 80
    - name: https
      port: 443
      targetPort: 443
