# BuildMax Portal — React/Vite static build, served by nginx.
#
# The build context is the repository root, not this directory.
#
# Build: docker build -f deployment/docker/Dockerfile.portal -t buildmax-portal:local .
# Run:   docker run -p 8080:80 -e BUILDMAX_API_BASE=http://localhost:5678 buildmax-portal:local
#
# The published image is ghcr.io/icloudbb/buildmax-portal, built by
# .github/workflows/portal-image.yml. See docs/deploy/overview.md.

# Stage 1: build.
#
# --platform=$BUILDPLATFORM pins this stage to the machine doing the building
# rather than the image's target architecture. The output is static JavaScript
# and CSS, identical on every platform, so emulating arm64 to run npm would cost
# minutes per build and produce the same bytes.
FROM --platform=$BUILDPLATFORM node:24-alpine AS build
WORKDIR /app

# Build the shared gui package first so portal's local file dependency
# resolves with generated dist assets and type declarations.
COPY gui/package.json gui/package-lock.json /app/gui/
WORKDIR /app/gui
RUN npm ci
COPY gui/ /app/gui/
RUN npm run build

WORKDIR /app/portal
COPY portal/package.json portal/package-lock.json /app/portal/
RUN npm ci
COPY portal/ /app/portal/
# The end-user manual lives at the repository root. portal's prebuild hook
# (scripts/sync-manual.mjs) mirrors it into public/help so the Vite build ships it
# into dist/; copy it into the stage first so that hook finds it.
COPY manual/ /app/manual/
RUN npm run build

# The bundle distributes MIT/ISC-licensed npm code to every browser, so the
# attribution ships next to it, served as a plain file. This is the npm
# counterpart of the NOTICE-THIRD-PARTY that release archives carry for the
# statically linked Go binaries.
RUN node scripts/collect-notices.mjs --out dist/third-party-notices.txt /app/gui /app/portal

# Stage 2: serve. Named so CI can rebuild it without its layer cache: a cached
# `apk upgrade` layer keeps whatever packages were current when it was first
# built, which is how a fixed pcre2 CVE still failed the release scan.
FROM nginx:alpine-slim AS serve
# Keep the installed packages current between upstream image refreshes.
RUN apk upgrade --no-cache
COPY --from=build /app/portal/dist /usr/share/nginx/html
COPY portal/nginx-default.conf /etc/nginx/conf.d/default.conf
# The image itself distributes Apache-2.0 code, so it carries the license text,
# like the server image's extra_files in .goreleaser.yaml.
COPY LICENSE /usr/share/licenses/buildmax-portal/LICENSE

# nginx's own entrypoint runs everything in this directory before starting, so
# the API URL is applied at container start instead of being baked into the
# bundle. Without it a published image could only ever talk to one server.
COPY portal/docker-entrypoint.d/20-buildmax-config.sh /docker-entrypoint.d/20-buildmax-config.sh
RUN chmod +x /docker-entrypoint.d/20-buildmax-config.sh

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
