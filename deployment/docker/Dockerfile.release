# Release image. Unlike Dockerfile.buildmax next to it, which compiles from
# source, this one only packages binaries that GoReleaser has already
# cross-compiled, so the published image and the published archives contain
# byte-identical builds.
#
# GoReleaser's dockers_v2 lays the build context out as <os>/<arch>/<binary> so
# that one Dockerfile can serve every platform, which is why the COPY paths go
# through TARGETOS and TARGETARCH. BuildKit sets both automatically.
#
# It is not meant to be run by hand — GoReleaser supplies the context. For a
# local image, use ./make kind reload, which uses Dockerfile.buildmax.
FROM alpine:3.23

ARG TARGETOS
ARG TARGETARCH

# Upgrade before installing: the base tag lags the branch's security
# updates, and the release scan fails on a fixed CVE the base still
# carries. v0.2.0-alpha.3 published with openssl 3.5.7-r0 this way.
#
# bubblewrap + socat are the Linux sandbox backend buildmax-worker resolves to
# once agentapp/taskrun selects config.SandboxSurfaceWorker (see
# docs/design/sandbox-boundaries.md §7.2). The worker baseline sets
# fail_if_unavailable: true, so a worker image missing either package refuses
# every run rather than executing model-chosen shell commands unconfined.
# curl is the HTTPS client an Agent gets: busybox wget (Alpine's default) cannot
# tunnel HTTPS through the sandbox's CONNECT proxy, so `wget https://…` fails 502
# even for a host the network tier allows. curl does CONNECT, so a run under the
# registries/open tier can actually fetch over HTTPS with the client it has.
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates bubblewrap socat curl

# Tells agentapp/taskrun (config.WorkerSandboxSurface) that this image
# actually installs the backend above, so it is safe to select the stricter
# worker baseline. A bare host running the same binary -- local_process
# deployments, CI, native Windows -- never sets this and keeps the CLI
# baseline instead, exactly as it did before the worker surface existed.
ENV BUILDMAX_SANDBOX_BACKEND_INSTALLED=1

# The server spawns the worker by name, so they have to share a PATH directory.
COPY ${TARGETOS}/${TARGETARCH}/buildmax \
     ${TARGETOS}/${TARGETARCH}/buildmax-server \
     ${TARGETOS}/${TARGETARCH}/buildmax-worker \
     /usr/local/bin/

COPY LICENSE NOTICE-THIRD-PARTY /usr/local/share/buildmax/

ENTRYPOINT ["/usr/local/bin/buildmax"]
